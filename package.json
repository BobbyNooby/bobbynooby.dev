{
	"name": "bobbynooby-monorepo",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"dev:web": "bun run --cwd apps/web dev",
		"dev:backend": "bun run --cwd apps/backend dev",
		"build": "bun run --cwd apps/web build",
		"check": "bun run --cwd apps/web check",
		"lint": "bun run --cwd apps/web lint",
		"test": "bun run --cwd apps/web test && vitest run",
		"format": "bun run --cwd apps/web format"
	},
	"devDependencies": {
		"vitest": "3"
	}
}
